{
  "name": "cliniqo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.js",
    "check:security": "node --conditions=react-server scripts/security-invariants.mjs",
    "check:deps": "npm audit --audit-level=high --omit=dev",
    "check:permissions": "node --env-file-if-exists=.env --conditions=react-server scripts/check-permissions.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env ./scripts/migrate.js",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:setup": "npm run db:migrate && docker exec cliniqo-postgres psql -U cliniqo_owner -d cliniqo -c \"ALTER ROLE cliniqo_app WITH PASSWORD 'localtest'\"",
    "db:seed": "node --env-file-if-exists=.env ./scripts/seed-dev.js",
    "staff:setup-link": "node --env-file-if-exists=.env ./scripts/issue-setup-link.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test-setup": "node --env-file-if-exists=.env ./scripts/test-db.js",
    "db:reset": "docker compose down -v && docker compose up -d && node ./scripts/wait-for-db.js && npm run db:setup",
    "verify": "npm run typecheck && npm run lint && npm run check:security && npm run check:deps && npm run db:check",
    "maintenance": "node --env-file-if-exists=.env ./scripts/maintenance.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.4",
    "pg": "^8.16.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.7"
  }
}
