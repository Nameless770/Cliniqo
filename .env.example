# ---------------------------------------------------------------------------
# Cliniqo environment
#
# Copy to .env for local development:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# Every variable below is validated at process start by src/env/server.ts. A missing or
# malformed value stops the server at boot rather than surfacing as a 500 later.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Absolute base URL. REQUIRED in production, and must be https there.
# Deriving it from request headers instead is how host-header injection turns a
# password-reset link into an attacker-controlled domain.
APP_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info


# --- Database --------------------------------------------------------------
# Two roles, two URLs, on purpose:
#
#   DATABASE_MIGRATION_URL  schema owner. Runs DDL. Used ONLY by `npm run db:migrate`.
#                           Not read by the application and not in the runtime env.
#   DATABASE_URL            application role. No DDL, and no UPDATE/DELETE on
#                           audit_event -- which is what makes the audit log immutable
#                           rather than merely intended to be.
#
# If both point at the same superuser, the audit-log guarantee is decorative.
#
# Migration 0001 creates cliniqo_app WITHOUT a password (a credential in version control
# is a credential leak). `npm run db:setup` sets the local-only password below; in
# production it is provisioned by infrastructure and never written to a file.
DATABASE_MIGRATION_URL=postgres://cliniqo_owner:cliniqo_local_dev@127.0.0.1:5432/cliniqo
DATABASE_URL=postgres://cliniqo_app:localtest@127.0.0.1:5432/cliniqo

# verify | disable
# TLS to the database. "disable" is permitted ONLY for the local Docker Compose instance
# on loopback; the env validator refuses to start with it when NODE_ENV=production.
DATABASE_SSL=disable

# PEM-encoded CA bundle for verifying the database server certificate.
# Optional when the provider's CA is already in the system trust store.
# DATABASE_CA_CERT=

# Connection pool ceiling per application instance. 1-100.
DATABASE_POOL_MAX=10


# --- Sessions --------------------------------------------------------------
# Signing key for session cookies. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The validator rejects anything that still looks like a placeholder in production.
SESSION_SECRET=replace-me-with-32-plus-random-characters-abcdefgh

# Automatic logoff (HIPAA 164.312(a)(2)(iii)). Slides forward on activity. 1-120.
SESSION_IDLE_TIMEOUT_MINUTES=15

# Hard ceiling regardless of activity. Does not slide. 1-24.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12


# --- Rate limiting ---------------------------------------------------------
# Applied per-account AND per-IP simultaneously: per-IP alone misses distributed
# credential stuffing, per-account alone lets one host spray many accounts.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15


# --- Development only ------------------------------------------------------
# Enables the synthetic data seeder. Seed data must be synthetic (HIPAA 164.514) --
# a copy of production is not a test fixture. Forced false in production.
ALLOW_SEED_DATA=false


# --- Public (inlined into the browser bundle -- PUBLIC FOREVER) ------------
# Anything prefixed NEXT_PUBLIC_ is readable by anyone who opens devtools, and cannot be
# unshipped from a browser cache. Never put a secret here.
NEXT_PUBLIC_APP_NAME=Cliniqo


# --- Deliberately absent ---------------------------------------------------
# No email, SMS, error-tracking, or analytics credentials. Each of those vendors would
# receive PHI and needs a signed Business Associate Agreement first (CLAUDE.md).
# Adding one is a decision, not a configuration change.

# Deployment environment, operator-controlled. Distinct from NODE_ENV, which the build
# tool sets. Production invariants (TLS required, https APP_URL, no placeholder secret)
# are gated on THIS, so a production-mode build in CI does not need production config.
# development | test | staging | production
APP_ENV=development
