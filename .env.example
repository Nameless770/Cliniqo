# ---------------------------------------------------------------------------
# Cliniqo environment
#
# Copy to .env for local development:  cp .env.example .env
# .env is gitignored and must never be committed.
#
# Every variable below is validated at process start by src/env/server.ts. A missing or
# malformed value stops the server at boot rather than surfacing as a 500 later.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development

# Absolute base URL. REQUIRED in production, and must be https there.
# Deriving it from request headers instead is how host-header injection turns a
# password-reset link into an attacker-controlled domain.
APP_URL=http://localhost:3000

# debug | info | warn | error
LOG_LEVEL=info


# --- Database --------------------------------------------------------------
# Two roles, two URLs, on purpose:
#
#   DATABASE_MIGRATION_URL  schema owner. Runs DDL. Used ONLY by `npm run db:migrate`.
#                           Not read by the application and not in the runtime env.
#   DATABASE_URL            application role. No DDL, and no UPDATE/DELETE on
#                           audit_event -- which is what makes the audit log immutable
#                           rather than merely intended to be.
#
# If both point at the same superuser, the audit-log guarantee is decorative.
#
# Migration 0001 creates cliniqo_app WITHOUT a password (a credential in version control
# is a credential leak). `npm run db:setup` sets the local-only password below; in
# production it is provisioned by infrastructure and never written to a file.
DATABASE_MIGRATION_URL=postgres://cliniqo_owner:cliniqo_local_dev@127.0.0.1:5432/cliniqo
DATABASE_URL=postgres://cliniqo_app:localtest@127.0.0.1:5432/cliniqo

# verify | disable
# TLS to the database. "disable" is permitted ONLY for the local Docker Compose instance
# on loopback; the env validator refuses to start with it when NODE_ENV=production.
DATABASE_SSL=disable

# PEM-encoded CA bundle for verifying the database server certificate.
# Optional when the provider's CA is already in the system trust store.
# DATABASE_CA_CERT=

# Connection pool ceiling per application instance. 1-100.
DATABASE_POOL_MAX=10


# --- Sessions --------------------------------------------------------------
# Signing key for session cookies. Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The validator rejects anything that still looks like a placeholder in production.
SESSION_SECRET=replace-me-with-32-plus-random-characters-abcdefgh

# Automatic logoff (HIPAA 164.312(a)(2)(iii)). Slides forward on activity. 1-120.
SESSION_IDLE_TIMEOUT_MINUTES=15

# Hard ceiling regardless of activity. Does not slide. 1-24.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12


# --- Rate limiting ---------------------------------------------------------
# Applied per-account AND per-IP simultaneously: per-IP alone misses distributed
# credential stuffing, per-account alone lets one host spray many accounts.
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15


# --- Development only ------------------------------------------------------
# Enables the synthetic data seeder. Seed data must be synthetic (HIPAA 164.514) --
# a copy of production is not a test fixture. Forced false in production.
ALLOW_SEED_DATA=false


# --- Public (inlined into the browser bundle -- PUBLIC FOREVER) ------------
# Anything prefixed NEXT_PUBLIC_ is readable by anyone who opens devtools, and cannot be
# unshipped from a browser cache. Never put a secret here.
NEXT_PUBLIC_APP_NAME=Cliniqo


# --- Deliberately absent ---------------------------------------------------
# No email, SMS, error-tracking, or analytics credentials. Each of those vendors would
# receive PHI and needs a signed Business Associate Agreement first (CLAUDE.md).
# Adding one is a decision, not a configuration change.

# Deployment environment, operator-controlled. Distinct from NODE_ENV, which the build
# tool sets. Production invariants (TLS required, https APP_URL, no placeholder secret)
# are gated on THIS, so a production-mode build in CI does not need production config.
# development | test | staging | production
APP_ENV=development


# --- PHI read throttle -----------------------------------------------------
# An exfiltration ceiling, not a performance limit. Every read is audited either way;
# this is what stops a compromised account scraping the roster while it is happening.
# Sized far above real clinical use (a busy clinician opens tens of charts a day).
PHI_READ_LIMIT=120
PHI_READ_WINDOW_MINUTES=10
# Reads/hour above which an actor is surfaced on the dashboard for review.
PHI_READ_ALERT_PER_HOUR=200

# --- Symptom triage ---------------------------------------------------------
# Which engine answers a patient's symptom description.
#
#   local  (default) — in-process and deterministic. The symptom text NEVER leaves
#                      this server. No key, no vendor, no BAA needed.
#   openai           — sends the symptom text to OpenAI. This is a DISCLOSURE OF PHI.
#
# The emergency check (chest pain, stroke signs, self-harm, ...) runs before either
# engine and is never delegated to a model, whichever of these is set.
TRIAGE_ENGINE=local

# Required when TRIAGE_ENGINE=openai. Startup fails without it.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Required when TRIAGE_ENGINE=openai. Startup fails while this is false.
#
# OpenAI will sign a Business Associate Agreement for API use on eligible plans with
# zero data retention. The FREE TIER IS NOT ELIGIBLE and trains on submitted data, so
# a free-tier key must never be pointed at real patients. Setting this to true is an
# operator asserting that a signed BAA covers the vendor.
TRIAGE_THIRD_PARTY_BAA_ACKNOWLEDGED=false

# --- Google sign-in (STAFF) -------------------------------------------------
# Optional. Leave unset and the feature does not exist: no button, no flow.
# Password sign-in is always available and is never replaced.
#
# Signing in with Google LINKS to an account an administrator already created. It never
# creates one — otherwise anyone with a Google address could mint a staff login.
#
# Register the redirect URI with Google as: <APP_URL>/auth/google/callback
# APP_URL is required when these are set; the redirect is built from it, never from
# request headers.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Restrict to one Google Workspace domain, checked server-side against the `hd` claim.
# Strongly recommended for staff. Cannot be combined with PORTAL_GOOGLE_SIGN_IN below:
# patients use personal Google accounts, which carry no `hd` claim at all, so this would
# refuse every one of them. The validator rejects the combination at startup.
# GOOGLE_ALLOWED_HD=your-clinic.example


# --- Google sign-in for PATIENTS (OFF BY DEFAULT) ---------------------------
# A SEPARATE DECISION from the staff setting above, and not one to make casually.
#
#   A staff member signing in with Google tells Google that one of its users
#   authenticated to an application. They are an employee. Nothing about that is health
#   information about anybody.
#
#   A PATIENT signing in the same way tells Google that a specific identified person
#   holds an account at a specific medical practice — which is to say, that they receive
#   care there. That IS health information about that person, disclosed to a company
#   that signs no Business Associate Agreement for consumer sign-in.
#
# It is lawful because an individual may authorize disclosures about themselves
# (§164.508), so the flow is built so the patient is genuinely the one choosing: the
# portal states in plain language what Google learns BEFORE the button that tells it, the
# authorization is recorded in `patient_identity` and audited as `identity.link`, and the
# patient can withdraw it from their account page.
#
# This flag is the layer above that — the clinic deciding to offer the choice at all.
# Leave it false and patients see only password sign-in.
#
# Register the SECOND redirect URI with Google as: <APP_URL>/portal/auth/google/callback
# It is a different door from the staff callback on purpose: neither flow can complete
# the other's handshake, so a patient's sign-in cannot resolve to a staff session.
# PORTAL_GOOGLE_SIGN_IN=false
